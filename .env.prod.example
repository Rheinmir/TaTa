# TaTa production env — copy → .env.prod, điền giá trị thật (.env.prod đã gitignore).

# ── Postgres (app) ── POSTGRES_PASSWORD và mật khẩu trong TATA_DATABASE_URL phải KHỚP nhau
POSTGRES_PASSWORD=CHANGE_ME_strong
TATA_DATABASE_URL=postgresql://tata:CHANGE_ME_strong@tata-app-db:5432/tata

# ── AI extractor (Azure Foundry qua LiteLLM) ──
TATA_LLM_BASE_URL=https://data-warehouse-resource.services.ai.azure.com/models
TATA_LLM_API_KEY=                # ⚠️ secret — ROTATE key cũ đã lộ
TATA_LLM_FLAVOR=azure
AZURE_API_VERSION=2024-05-01-preview
TATA_EXTRACT_MODEL=gpt-4.1-mini
TATA_CONFIDENCE_MIN=0.7

# ── Notion (kho nhân sự + task) ──
NOTION_TOKEN=
NOTION_PERSONNEL_DB_ID=
NOTION_TASKS_DB_ID=

# ── Notify: Email (SMTP) ── (hoặc đổi sang MS Graph sau)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tata@giatbh.io.vn

# ── Notify: Zalo outbound (qua zca-bridge) ──
BRIDGE_OUTBOUND_URL=
BRIDGE_OUTBOUND_TOKEN=

# ── Notify: Teams (MS Graph) ──
TEAMS_GRAPH_TENANT=
TEAMS_GRAPH_CLIENT_ID=
TEAMS_GRAPH_SECRET=

# ── AI hook callback (để AI POST kết quả về) ──
TATA_CALLBACK_BASE=https://tata.giatbh.io.vn
