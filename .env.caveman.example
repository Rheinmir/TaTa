# TaTa env mẫu (copy → .env.caveman, điền giá trị thật; .env.caveman đã gitignore)

# ── Store backend (chọn 1; ưu tiên Postgres > Supabase > JSON fallback) ──
# Postgres trực tiếp (DB truyền thống / deploy server). Dev local:
TATA_DATABASE_URL=postgresql://tata:tata@localhost:5544/tata
# Hoặc Supabase:
# SUPABASE_URL=
# SUPABASE_KEY=

# ── Notion (kho nhân sự dual-store + sync task) ──
# NOTION_TOKEN=
# NOTION_PERSONNEL_DB_ID=

# ── AI extractor (Phase 2) — Azure AI Foundry qua LiteLLM ──
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=        # ⚠️ secret — KHÔNG commit; rotate nếu lộ
# AZURE_API_VERSION=2024-05-01-preview
# TATA_EXTRACT_MODEL=gpt-4.1-mini
